#! /usr/bin/env python

import argparse

from commands import reindex

parser = argparse.ArgumentParser(
    prog='git reindex',
    description=reindex.__doc__,
    epilog='for more detail, use: git help reindex'
)
parser.add_argument('-v', '--version', action='version', version='git-reindex 0.8.0')

parser.parse_args()
reindex.reindex()
